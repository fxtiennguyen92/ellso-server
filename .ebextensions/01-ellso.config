# Cấu hình Elastic Beanstalk cho ellso-server (PHP 8.4 / Amazon Linux 2023).
# Áp dụng mỗi lần deploy. Biến môi trường (APP_KEY, DB_*, AWS_*…) đặt trong console, KHÔNG để ở đây.
option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    memory_limit: 512M
    max_execution_time: 120
    display_errors: "Off"
    # Chỉ dùng khi bundle không có sẵn vendor/ (bundle do GitHub Actions build đã có vendor → EB bỏ qua composer)
    composer_options: --no-dev --optimize-autoloader --no-interaction --prefer-dist
  aws:autoscaling:launchconfiguration:
    # Cắt video HLS cần chỗ trống tạm (file gốc tới 2 GB + bản 480p/720p)
    RootVolumeType: gp3
    RootVolumeSize: "30"

files:
  "/etc/php.d/99-ellso.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      ; Ảnh / file nhỏ đi qua server; video & file lớn tải thẳng lên S3 (Livewire S3 upload)
      upload_max_filesize = 64M
      post_max_size = 64M
      expose_php = Off

  # Log Laravel hiện trong "Logs › Request logs" của Elastic Beanstalk
  "/opt/elasticbeanstalk/tasks/taillogs.d/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/app/current/storage/logs/*.log
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/app/current/storage/logs/*.log
      /var/log/ellso-queue.log
  "/opt/elasticbeanstalk/tasks/taillogs.d/ellso-queue.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/ellso-queue.log
