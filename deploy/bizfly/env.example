# Mẫu /var/www/ellso/shared/.env trên server BizFly. Thay các chỗ viết HOA.
# KHÔNG commit giá trị thật (repo public). Sau khi sửa: bash /var/www/ellso/current/deploy/bizfly/artisan.sh optimize
#   rồi systemctl reload php8.4-fpm && systemctl restart ellso-queue

APP_NAME=Ellso
APP_ENV=production
APP_DEBUG=false
APP_KEY=APP_KEY_VUA_TAO
APP_URL=https://cms.ellso.edu.vn
CMS_DOMAIN=cms.ellso.edu.vn
API_DOMAIN=api.ellso.edu.vn

LOG_CHANNEL=daily
LOG_LEVEL=info
# nginx nhận request trực tiếp (không có Load Balancer) → KHÔNG đặt TRUSTED_PROXIES
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true

# Cloud Database MySQL (HCM1, IP nội bộ)
DB_CONNECTION=mysql
DB_HOST=10.20.1.19
DB_PORT=3306
DB_DATABASE=ellso
DB_USERNAME=ellso_app
DB_PASSWORD=MAT_KHAU_ELLSO

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700

# BizFly Simple Storage (HCM): ảnh ở bucket công khai, tài liệu ở bucket riêng tư
MEDIA_DISK=media_s3
DOCUMENTS_DISK=documents_s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=documents_s3
AWS_ACCESS_KEY_ID=ACCESS_KEY_BIZFLY
AWS_SECRET_ACCESS_KEY=SECRET_KEY_BIZFLY
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=https://hcm.ss.bfcplatform.vn
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=ellso-documents
AWS_MEDIA_BUCKET=ellso-media
AWS_URL=https://hcm.ss.bfcplatform.vn/ellso-media
MEDIA_S3_ACL=public-read
DOCUMENTS_S3_ACL=private

FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
QPDF_BINARY=/usr/bin/qpdf

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=EMAIL_GUI_THU
MAIL_PASSWORD=APP_PASSWORD_GMAIL
MAIL_FROM_ADDRESS=EMAIL_GUI_THU
MAIL_FROM_NAME=Ellso

# Tạm thời trước khi launch. Khi launch: XOÁ dòng này + reset database.
ALLOW_DEMO_SEED=true
